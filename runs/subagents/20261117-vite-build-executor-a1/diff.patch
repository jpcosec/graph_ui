+def test_build_timeout_leaves_no_process_of_vite_build_alive(tmp_path):
+    """A ``vite build`` past its timeout raises ``TimeoutExpired`` and leaves no process holding its outDir."""
+    if not (shutil.which("npx") and (APP / "node_modules").is_dir()):
+        pytest.skip("review-workbench needs node and `npm ci` in apps/review-workbench")
+    if not Path("/proc/self/cmdline").exists():
+        pytest.skip("needs /proc to list the processes")
+    dist = tmp_path / "rw-views-build-timeout" / "dist"
+    dist.parent.mkdir()
+    with pytest.raises(subprocess.TimeoutExpired):
+        _build(dist, timeout=1)
+    left = _holding(str(dist))
+    for pid in left:  # do not leak this run's processes even when the assertion fails
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+    assert left == [], f"processes still holding {dist} after the build timed out: {left}"
+
