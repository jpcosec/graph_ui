        assert len(set(expected.values())) == 2
        for d in ('desk/notas/alfa', 'desk/notas/beta'):
            (root / d).mkdir(parents=True, exist_ok=True)
            (root / d / 'LEEME.md').write_text(f'# LEEME\n\nContenido de {d}.\n', encoding='utf-8')
