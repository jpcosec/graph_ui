+def _holding(marker: str) -> list[int]:
+    """Pids of the live processes whose command line contains ``marker``, read from /proc."""
+    pids = []
+    for cmdline in Path("/proc").glob("[0-9]*/cmdline"):
+        try:
+            argv = cmdline.read_bytes().split(b"\0")
+        except OSError:  # the process exited while we read it
+            continue
+        if any(marker.encode() in arg for arg in argv):
+            pids.append(int(cmdline.parent.name))
+    return pids
+
+
+def test_stop_leaves_no_process_of_vite_preview_alive(tmp_path):
+    """``_stop`` takes down ``npx vite preview`` and the ``node vite preview`` it forks: nothing keeps the outDir."""
+    if not (shutil.which("npx") and (APP / "node_modules").is_dir()):
+        pytest.skip("review-workbench needs node and `npm ci` in apps/review-workbench")
+    if not Path("/proc/self/cmdline").exists():
+        pytest.skip("needs /proc to list the processes")
+    out = tmp_path / "rw-views-stop"
+    out.mkdir()
+    (out / "index.html").write_text("<!doctype html><title>rw-views-stop</title>")
+    port = _free_port()
+    process = _spawn(["npx", "vite", "preview", "--outDir", str(out), "--port", str(port), "--strictPort",
+                      "--host", "127.0.0.1"], cwd=APP)
+    try:
+        _wait(f"http://127.0.0.1:{port}/", process)
+        assert _holding(str(out)), "vite preview should be running with this outDir before _stop"
+    finally:
+        _stop([process])
+    left = _holding(str(out))
+    for pid in left:  # do not leak this run's processes even when the assertion fails
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+    assert left == [], f"processes still holding {out} after _stop: {left}"
+
