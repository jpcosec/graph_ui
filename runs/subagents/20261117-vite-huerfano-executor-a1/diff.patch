+def _spawn(cmd: list[str], **kw) -> subprocess.Popen:
+    """Start a long-lived server as the leader of its own process group.
+
+    ``npx vite preview`` forks ``node .../vite preview``; signalling only the npx Popen left that
+    node child alive after every run. With its own session the leader's pid is the group id, so
+    ``_stop`` reaches every process the command forked.
+    """
+    kw.setdefault("stdout", subprocess.DEVNULL)
+    kw.setdefault("stderr", subprocess.DEVNULL)
+    return subprocess.Popen(cmd, start_new_session=True, **kw)
+
+
+def _group_alive(process: subprocess.Popen) -> bool:
+    process.poll()  # reap the leader once it exits, so a zombie leader does not keep the group "alive"
+    try:
+        os.killpg(process.pid, 0)
+    except ProcessLookupError:
+        return False
+    return True
+
+
+def _stop(processes: list[subprocess.Popen], timeout: float = 10) -> None:
+    """SIGTERM every process group started by ``_spawn``; SIGKILL the groups still alive after ``timeout``."""
+    for process in processes:
+        try:
+            os.killpg(process.pid, signal.SIGTERM)  # pgid == pid: _spawn starts a new session
+        except ProcessLookupError:
+            pass
+    deadline = time.time() + timeout
+    for process in processes:
+        while _group_alive(process) and time.time() < deadline:
+            time.sleep(0.1)
+        if _group_alive(process):
+            try:
+                os.killpg(process.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+        process.wait(timeout=timeout)
+
