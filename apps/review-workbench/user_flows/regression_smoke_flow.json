{
  "name": "Regression Smoke Flow",
  "baseUrl": "http://127.0.0.1:5173",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the workbench"
    },
    {
      "id": "02_wait_graph_nodes",
      "action": "assert_count_at_least",
      "selector": ".react-flow__node",
      "value": 10,
      "description": "Verify nodes are present on first render"
    },
    {
      "id": "03_switch_structure",
      "action": "click",
      "selector": "[data-testid='mode-tab-structure']",
      "description": "Confirm structure mode remains reachable"
    },
    {
      "id": "04_wait_structure_tab",
      "action": "wait_text",
      "value": "Expand a file to inspect top-level forms",
      "description": "Wait for structure guidance"
    },
    {
      "id": "05_switch_body",
      "action": "click",
      "selector": "[data-testid='mode-tab-body']",
      "description": "Switch to body mode"
    },
    {
      "id": "06_wait_body_mode",
      "action": "wait",
      "selector": "[data-testid='node-organ-core']",
      "description": "Wait for body nodes"
    },
    {
      "id": "07_switch_compare",
      "action": "click",
      "selector": "[data-testid='mode-tab-compare']",
      "description": "Switch to compare mode"
    },
    {
      "id": "08_wait_compare_nodes",
      "action": "wait",
      "selector": "[data-testid='node-trace-trace-inspection-loop-te-inspect-1']",
      "description": "Wait for compare overlay"
    },
    {
      "id": "09_assert_edges_visible",
      "action": "assert_count_at_least",
      "selector": ".react-flow__edge",
      "value": 5,
      "description": "Ensure edges remain rendered"
    }
  ]
}
