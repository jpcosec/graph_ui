{
  "name": "Encoding View Full Interaction Flow",
  "baseUrl": "http://127.0.0.1:5173",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the workbench in structure mode"
    },
    {
      "id": "02_wait_graph_loaded",
      "action": "wait",
      "selector": "[data-testid='node-ast-main-form-main-7']",
      "timeout": 10000,
      "description": "Wait for the HUM structure graph to fully render"
    },
    {
      "id": "03_assert_initial_node_count",
      "action": "assert_count_equals",
      "selector": ".react-flow__node",
      "value": 111,
      "description": "Verify baseline node count (111). Proves no regression from encoding/layout refactors."
    },
    {
      "id": "04_wait_encoding_section",
      "action": "wait",
      "selector": "[data-testid='encoding-section']",
      "description": "Wait for the EncodingSection to render in the sidebar"
    },
    {
      "id": "05_wait_views_section",
      "action": "wait",
      "selector": "[data-testid='views-section']",
      "description": "Wait for the ViewsSection to render in the sidebar"
    },
    {
      "id": "06_select_form_node",
      "action": "dispatch_click",
      "selector": "[data-testid='node-ast-main-form-main-7']",
      "description": "Select a form node for editing"
    },
    {
      "id": "07_copy_node",
      "action": "click",
      "selector": "[data-testid='sidebar-copy']",
      "description": "Copy the selected node"
    },
    {
      "id": "08_paste_node",
      "action": "click",
      "selector": "[data-testid='sidebar-paste']",
      "description": "Paste a duplicate node to create a dirty state"
    },
    {
      "id": "09_verify_pasted_count",
      "action": "assert_count_equals",
      "selector": ".react-flow__node",
      "value": 112,
      "description": "Verify copy/paste still works with encoding sidebar present (112 nodes)"
    },
    {
      "id": "10_save_graph",
      "action": "click",
      "selector": "[data-testid='sidebar-save']",
      "description": "Save graph state to clear dirty flag"
    },
    {
      "id": "11_wait_save_disabled",
      "action": "assert_disabled",
      "selector": "[data-testid='sidebar-save']",
      "description": "Verify save button disables after saving (dirty state cleared)"
    },
    {
      "id": "12_type_view_name",
      "action": "fill",
      "selector": "input[aria-label='View name']",
      "value": "Comprehensive Test",
      "description": "Type a distinctive view name into the ViewsSection input"
    },
    {
      "id": "13_save_view",
      "action": "click",
      "selector": "text=Save current as view",
      "description": "Save the current state as a named view"
    },
    {
      "id": "14_reload_page",
      "action": "reload",
      "description": "Reload page to verify localStorage persistence"
    },
    {
      "id": "15_wait_sidebar_after_reload",
      "action": "wait",
      "selector": "[data-testid='encoding-section']",
      "description": "Wait for encoding section after reload"
    },
    {
      "id": "16_reset_to_defaults",
      "action": "click",
      "selector": "text=Reset to defaults",
      "description": "Reset encoding rules to defaults after reload"
    },
    {
      "id": "17_pause_after_reset",
      "action": "wait_fixed",
      "value": 500,
      "description": "Pause for re-render after reset"
    },
    {
      "id": "18_assert_node_count_stable",
      "action": "assert_count_at_least",
      "selector": ".react-flow__node",
      "value": 110,
      "description": "Node count still >= 110 after all encoding/sidebar operations, proving graph integrity"
    }
  ]
}