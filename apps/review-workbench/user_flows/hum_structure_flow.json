{
  "name": "HUM Structure Flow",
  "baseUrl": "http://127.0.0.1:5173",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the workbench in structure mode"
    },
    {
      "id": "02_wait_structure_copy",
      "action": "wait",
      "selector": "[data-testid='node-ast-main']",
      "description": "Wait for the HUM structure projection to render"
    },
    {
      "id": "03_wait_main_file",
      "action": "wait",
      "selector": "[data-testid='node-ast-main']",
      "description": "Wait for the top-level Lisp file group"
    },
    {
      "id": "04_collapse_main_file",
      "action": "click",
      "selector": "[aria-label='Collapse main.lisp']",
      "hoverSelector": "[data-testid='node-ast-main']",
      "hoverWaitMs": 100,
      "force": true,
      "description": "Collapse the main.lisp file group"
    },
    {
      "id": "05_wait_hidden_main_form",
      "action": "wait_hidden",
      "selector": "[data-testid='node-ast-main-form-main-7']",
      "description": "Verify the child form disappears when the group collapses"
    },
    {
      "id": "06_expand_main_file",
      "action": "click",
      "selector": "[aria-label='Expand main.lisp']",
      "hoverSelector": "[data-testid='node-ast-main']",
      "hoverWaitMs": 100,
      "force": true,
      "description": "Expand the main.lisp file group again"
    },
    {
      "id": "07_wait_visible_main_form",
      "action": "wait",
      "selector": "[data-testid='node-ast-main-form-main-7']",
      "description": "Verify the child form returns after expansion"
    },
    {
      "id": "08_select_core_form",
      "action": "dispatch_click",
      "selector": "[data-testid='node-ast-agent-core-form-agente-10']",
      "description": "Select a core execution form"
    },
    {
      "id": "09_assert_nodes_visible",
      "action": "assert_count_at_least",
      "selector": ".react-flow__node",
      "value": 20,
      "description": "Ensure the structure graph rendered many nodes"
    }
  ]
}
