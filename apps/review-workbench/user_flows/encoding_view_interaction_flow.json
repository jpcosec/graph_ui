{
  "name": "Encoding View Interaction Flow",
  "baseUrl": "http://127.0.0.1:5173",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the workbench"
    },
    {
      "id": "02_wait_encoding_section",
      "action": "wait",
      "selector": "[data-testid='encoding-section']",
      "timeout": 10000,
      "description": "Wait for the EncodingSection to render"
    },
    {
      "id": "03_wait_views_section",
      "action": "wait",
      "selector": "[data-testid='views-section']",
      "description": "Wait for the ViewsSection to render"
    },
    {
      "id": "04_type_view_name",
      "action": "fill",
      "selector": "input[aria-label='View name']",
      "value": "My Test View",
      "description": "Type a view name"
    },
    {
      "id": "05_save_named_view",
      "action": "click",
      "selector": "text=Save current as view",
      "description": "Save the named view"
    },
    {
      "id": "06_after_save_pause",
      "action": "wait_fixed",
      "value": 500,
      "description": "Wait for toast to render"
    },
    {
      "id": "07_reload_page",
      "action": "reload",
      "description": "Reload to verify localStorage persistence"
    },
    {
      "id": "08_wait_sidebar_reloaded",
      "action": "wait",
      "selector": "[data-testid='views-section']",
      "description": "Wait for sidebar after reload"
    },
    {
      "id": "09_fill_view_name_again",
      "action": "fill",
      "selector": "input[aria-label='View name']",
      "value": "Reloaded View",
      "description": "Type a different name to verify the view list persists"
    }
  ]
}