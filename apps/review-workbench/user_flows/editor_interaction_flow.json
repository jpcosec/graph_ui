{
  "name": "Editor Interaction Flow",
  "baseUrl": "http://127.0.0.1:5173",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the workbench"
    },
    {
      "id": "02_wait_graph_nodes",
      "action": "assert_count_at_least",
      "selector": ".react-flow__node",
      "value": 10,
      "description": "Verify the KB graph renders its nodes"
    },
    {
      "id": "03_select_node",
      "action": "dblclick",
      "selector": ".react-flow__node >> nth=0",
      "description": "Double click a node to open its inspector (double click is the repo convention)"
    },
    {
      "id": "04_wait_inspector",
      "action": "wait",
      "selector": "[data-testid='node-inspector-save']",
      "description": "Wait for the node inspector to render"
    },
    {
      "id": "05_wait_typed_field",
      "action": "wait",
      "selector": "[data-testid='field-title']",
      "description": "The inspector renders the typed fields of the KB model"
    },
    {
      "id": "06_wait_model_field",
      "action": "wait",
      "selector": "[data-testid='field-instructions']",
      "description": "The ConversationStep fields come from the served schema"
    },
    {
      "id": "07_inspector_save_reachable",
      "action": "wait",
      "selector": "[data-testid='node-inspector-save']",
      "description": "The per-document save (POST /sldb/save) is reachable from the UI"
    },
    {
      "id": "08_sidebar_reachable",
      "action": "wait",
      "selector": "[data-testid='sidebar-save']",
      "description": "The sidebar actions stay reachable with the inspector open"
    },
    {
      "id": "09_views_section",
      "action": "wait",
      "selector": "[data-testid='views-section']",
      "description": "ViewsSection survives the selection"
    },
    {
      "id": "10_reload_page",
      "action": "reload",
      "description": "Reload to confirm the graph is rebuilt from the KB"
    },
    {
      "id": "11_nodes_after_reload",
      "action": "assert_count_at_least",
      "selector": ".react-flow__node",
      "value": 10,
      "description": "The graph is rebuilt from the same source after reload"
    }
  ]
}