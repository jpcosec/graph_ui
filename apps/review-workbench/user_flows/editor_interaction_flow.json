{
  "name": "Editor Interaction Flow",
  "baseUrl": "http://127.0.0.1:5173",
  "steps": [
    {
      "id": "01_open_app",
      "action": "goto",
      "url": "/",
      "description": "Open the workbench in structure mode"
    },
    {
      "id": "02_wait_form_visible",
      "action": "wait",
      "selector": "[data-testid='node-ast-main-form-main-7']",
      "description": "Wait for an editable form node"
    },
    {
      "id": "03_assert_initial_count",
      "action": "assert_count_equals",
      "selector": ".react-flow__node",
      "value": 111,
      "description": "Verify the structure graph starts with the expected node count"
    },
    {
      "id": "04_select_form_node",
      "action": "dispatch_click",
      "selector": "[data-testid='node-ast-main-form-main-7']",
      "description": "Select the target structure node"
    },
    {
      "id": "05_copy_node",
      "action": "click",
      "selector": "[data-testid='sidebar-copy']",
      "description": "Copy the selected node through the sidebar"
    },
    {
      "id": "06_paste_node",
      "action": "click",
      "selector": "[data-testid='sidebar-paste']",
      "description": "Paste a duplicate node"
    },
    {
      "id": "07_wait_sidebar_save_enabled",
      "action": "assert_enabled",
      "selector": "[data-testid='sidebar-save']",
      "description": "Ensure the graph became dirty after paste"
    },
    {
      "id": "08_assert_pasted_count",
      "action": "assert_count_equals",
      "selector": ".react-flow__node",
      "value": 112,
      "description": "Verify a new node was added to the graph"
    },
    {
      "id": "09_save_graph",
      "action": "click",
      "selector": "[data-testid='sidebar-save']",
      "description": "Save the graph state"
    },
    {
      "id": "10_wait_sidebar_save_disabled",
      "action": "assert_disabled",
      "selector": "[data-testid='sidebar-save']",
      "description": "Ensure the dirty state clears after save"
    },
    {
      "id": "11_reload_page",
      "action": "reload",
      "description": "Reload the page to confirm persistence"
    },
    {
      "id": "12_assert_persisted_count",
      "action": "assert_count_equals",
      "selector": ".react-flow__node",
      "value": 112,
      "description": "Verify the saved duplicate remains after reload"
    }
  ]
}
