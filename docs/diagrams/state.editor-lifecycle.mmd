    loading --> ready : data_ready
    loading --> error : fetch_failed
    ready --> inspecting : double_click_node
    inspecting --> ready : close
    inspecting --> saving : save_document
    saving --> ready : persisted
    saving --> inspecting : save_failed
    ready --> loading : reload