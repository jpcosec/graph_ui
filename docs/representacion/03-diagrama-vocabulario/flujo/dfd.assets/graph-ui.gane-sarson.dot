digraph dfd_graph_ui {
  rankdir=LR; node [fontname="Liberation Sans", fontsize=11]; edge [fontname="Liberation Sans", fontsize=9];
  "usuario" [shape=box, style=filled, fillcolor="#dddddd", label="Usuario (navegador)"];
  "sldb-externo" [shape=box, style=filled, fillcolor="#dddddd", label="Servidor SLDB (SLDB_URL)"];
  "p1" [shape=plaintext, label=<<table border="1" style="rounded" cellborder="0" cellspacing="0"><tr><td border="1" sides="B">1</td></tr><tr><td>Leer grafo</td></tr></table>>];
  "p2" [shape=plaintext, label=<<table border="1" style="rounded" cellborder="0" cellspacing="0"><tr><td border="1" sides="B">2</td></tr><tr><td>Guardar cambios</td></tr></table>>];
  "p3" [shape=plaintext, label=<<table border="1" style="rounded" cellborder="0" cellspacing="0"><tr><td border="1" sides="B">3</td></tr><tr><td>Importar mapa</td></tr></table>>];
  "p4" [shape=plaintext, label=<<table border="1" style="rounded" cellborder="0" cellspacing="0"><tr><td border="1" sides="B">4</td></tr><tr><td>Editar clases</td></tr></table>>];
  "p5" [shape=plaintext, label=<<table border="1" style="rounded" cellborder="0" cellspacing="0"><tr><td border="1" sides="B">5</td></tr><tr><td>Exportar</td></tr></table>>];
  "p6" [shape=plaintext, label=<<table border="1" style="rounded" cellborder="0" cellspacing="0"><tr><td border="1" sides="B">6</td></tr><tr><td>Reenviar a SLDB</td></tr></table>>];
  "d1" [shape=plaintext, label=<<table border="1" sides="LTB" cellborder="0" cellspacing="0"><tr><td border="1" sides="R">D1</td><td>Documentos</td></tr></table>>];
  "d2" [shape=plaintext, label=<<table border="1" sides="LTB" cellborder="0" cellspacing="0"><tr><td border="1" sides="R">D2</td><td>Vista</td></tr></table>>];
  "d3" [shape=plaintext, label=<<table border="1" sides="LTB" cellborder="0" cellspacing="0"><tr><td border="1" sides="R">D3</td><td>Modelos</td></tr></table>>];
  "usuario" -> "p1" [label="pedido de grafo"];
  "d1" -> "p1" [label="documentos"];
  "d2" -> "p1" [label="vista y revisión"];
  "d3" -> "p1" [label="esquema"];
  "p1" -> "usuario" [label="grafo"];
  "usuario" -> "p2" [label="cambios, vista, revisión"];
  "d1" -> "p2" [label="documentos actuales"];
  "d3" -> "p2" [label="clases para validar"];
  "p2" -> "d1" [label="documentos escritos"];
  "p2" -> "d2" [label="vista"];
  "p2" -> "usuario" [label="grafo refrescado o error"];
  "usuario" -> "p3" [label="JSON de intercambio"];
  "d1" -> "p3" [label="documentos existentes"];
  "d3" -> "p3" [label="modelos existentes"];
  "p3" -> "d3" [label="modelos compilados"];
  "p3" -> "d1" [label="documentos importados"];
  "p3" -> "d2" [label="vista importada"];
  "p3" -> "usuario" [label="plan o reporte"];
  "usuario" -> "p4" [label="cambios de clase"];
  "d3" -> "p4" [label="clase actual"];
  "p4" -> "d3" [label="borrador o modelo promovido"];
  "p4" -> "usuario" [label="detalle de clase"];
  "usuario" -> "p5" [label="pedido de exportación"];
  "d1" -> "p5" [label="documentos"];
  "d2" -> "p5" [label="vista"];
  "d3" -> "p5" [label="modelos"];
  "p5" -> "usuario" [label="JSON de intercambio"];
  "usuario" -> "p6" [label="consulta"];
  "p6" -> "sldb-externo" [label="consulta"];
  "sldb-externo" -> "p6" [label="respuesta"];
  "p6" -> "usuario" [label="respuesta"];
}
