{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "DSM de graph_ui con spec2viz (component_view_matrix)",
  "width": 1500,
  "height": 396,
  "padding": 5,
  "signals": [
    {
      "name": "left",
      "value": 220
    },
    {
      "name": "top",
      "value": 70
    },
    {
      "name": "cellWidth",
      "value": 140
    },
    {
      "name": "rowHeight",
      "value": 34
    },
    {
      "name": "barPadding",
      "value": 6
    }
  ],
  "data": [
    {
      "name": "stages",
      "values": [
        {
          "id": "shared",
          "index": 0,
          "label": "shared",
          "view": "depende de"
        },
        {
          "id": "source",
          "index": 1,
          "label": "source",
          "view": "depende de"
        },
        {
          "id": "views-draft-tree",
          "index": 2,
          "label": "views/draft/tree",
          "view": "depende de"
        },
        {
          "id": "dialogs",
          "index": 3,
          "label": "dialogs",
          "view": "depende de"
        },
        {
          "id": "shell",
          "index": 4,
          "label": "shell",
          "view": "depende de"
        },
        {
          "id": "views-documents-flow",
          "index": 5,
          "label": "views/documents/flow",
          "view": "depende de"
        },
        {
          "id": "views-documents-map",
          "index": 6,
          "label": "views/documents/map",
          "view": "depende de"
        },
        {
          "id": "views-models-diagram",
          "index": 7,
          "label": "views/models/diagram",
          "view": "depende de"
        },
        {
          "id": "app",
          "index": 8,
          "label": "app",
          "view": "depende de"
        }
      ]
    },
    {
      "name": "views",
      "source": "stages",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "view"
          ],
          "fields": [
            "index",
            "index"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "minIdx",
            "maxIdx"
          ]
        }
      ]
    },
    {
      "name": "viewBoundaries",
      "source": "views",
      "transform": [
        {
          "type": "formula",
          "expr": "[datum.minIdx, datum.maxIdx + 1]",
          "as": "indices"
        },
        {
          "type": "flatten",
          "fields": [
            "indices"
          ]
        },
        {
          "type": "aggregate",
          "groupby": [
            "indices"
          ]
        }
      ]
    },
    {
      "name": "stageBoundaries",
      "values": [
        {
          "index": 0
        },
        {
          "index": 1
        },
        {
          "index": 2
        },
        {
          "index": 3
        },
        {
          "index": 4
        },
        {
          "index": 5
        },
        {
          "index": 6
        },
        {
          "index": 7
        },
        {
          "index": 8
        },
        {
          "index": 9
        }
      ]
    },
    {
      "name": "rows",
      "values": [
        {
          "id": "shared",
          "label": "shared",
          "row": 0,
          "depth": 0
        },
        {
          "id": "source",
          "label": "source",
          "row": 1,
          "depth": 0
        },
        {
          "id": "views-draft-tree",
          "label": "views/draft/tree",
          "row": 2,
          "depth": 0
        },
        {
          "id": "dialogs",
          "label": "dialogs",
          "row": 3,
          "depth": 0
        },
        {
          "id": "shell",
          "label": "shell",
          "row": 4,
          "depth": 0
        },
        {
          "id": "views-documents-flow",
          "label": "views/documents/flow",
          "row": 5,
          "depth": 0
        },
        {
          "id": "views-documents-map",
          "label": "views/documents/map",
          "row": 6,
          "depth": 0
        },
        {
          "id": "views-models-diagram",
          "label": "views/models/diagram",
          "row": 7,
          "depth": 0
        },
        {
          "id": "app",
          "label": "app",
          "row": 8,
          "depth": 0
        }
      ]
    },
    {
      "name": "spans",
      "values": [
        {
          "component": "source",
          "row": 1,
          "start": 0,
          "end": 1,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-draft-tree",
          "row": 2,
          "start": 0,
          "end": 2,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "dialogs",
          "row": 3,
          "start": 0,
          "end": 1,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "dialogs",
          "row": 3,
          "start": 4,
          "end": 5,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "shell",
          "row": 4,
          "start": 0,
          "end": 4,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "shell",
          "row": 4,
          "start": 5,
          "end": 8,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-documents-flow",
          "row": 5,
          "start": 0,
          "end": 2,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-documents-flow",
          "row": 5,
          "start": 4,
          "end": 5,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-documents-map",
          "row": 6,
          "start": 0,
          "end": 2,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-documents-map",
          "row": 6,
          "start": 4,
          "end": 5,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-models-diagram",
          "row": 7,
          "start": 0,
          "end": 2,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "views-models-diagram",
          "row": 7,
          "start": 4,
          "end": 5,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "app",
          "row": 8,
          "start": 0,
          "end": 2,
          "kind": "core",
          "depth": 0
        },
        {
          "component": "app",
          "row": 8,
          "start": 4,
          "end": 5,
          "kind": "core",
          "depth": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "kindColor",
      "type": "ordinal",
      "domain": [
        "core"
      ],
      "range": [
        "#F59E0B"
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {
        "data": "views"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + (datum.minIdx + datum.maxIdx + 1) * cellWidth / 2"
          },
          "y": {
            "value": 15
          },
          "text": {
            "field": "view"
          },
          "align": {
            "value": "center"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 15
          },
          "fill": {
            "value": "#475569"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "stages"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.index * cellWidth + cellWidth / 2"
          },
          "y": {
            "value": 40
          },
          "text": {
            "field": "label"
          },
          "align": {
            "value": "center"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#475569"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "stageBoundaries"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.index * cellWidth"
          },
          "y": {
            "signal": "top - 20"
          },
          "y2": {
            "signal": "top + 9 * rowHeight + 10"
          },
          "stroke": {
            "value": "#CBD5E1"
          },
          "strokeDash": {
            "value": [
              4,
              4
            ]
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "viewBoundaries"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.indices * cellWidth"
          },
          "y": {
            "signal": "top - 40"
          },
          "y2": {
            "signal": "top + 9 * rowHeight + 20"
          },
          "stroke": {
            "value": "#475569"
          },
          "strokeWidth": {
            "value": 2.5
          },
          "strokeOpacity": {
            "value": 0.6
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "signal": "top + datum.row * rowHeight"
          },
          "height": {
            "signal": "rowHeight"
          },
          "fill": {
            "signal": "datum.depth === 0 ? (datum.row % 2 === 0 ? '#475569' : '#94A3B8') : (datum.row % 2 === 0 ? '#CBD5E1' : '#E2E8F0')"
          },
          "fillOpacity": {
            "value": 0.15
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "12 + datum.depth * 18"
          },
          "x2": {
            "signal": "12 + datum.depth * 18"
          },
          "y": {
            "signal": "top + datum.row * rowHeight + 2"
          },
          "y2": {
            "signal": "top + datum.row * rowHeight + rowHeight - 2"
          },
          "stroke": {
            "signal": "datum.depth === 0 ? '#475569' : '#94A3B8'"
          },
          "strokeWidth": {
            "signal": "datum.depth === 0 ? 3 : 1.5"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "20 + datum.depth * 18"
          },
          "y": {
            "signal": "top + datum.row * rowHeight + rowHeight / 2"
          },
          "text": {
            "field": "label"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#111827"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "spans"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.start * cellWidth + 4"
          },
          "x2": {
            "signal": "left + datum.end * cellWidth - 4"
          },
          "y": {
            "signal": "top + datum.row * rowHeight + barPadding"
          },
          "height": {
            "signal": "rowHeight - barPadding * 2"
          },
          "cornerRadius": {
            "value": 7
          },
          "fill": {
            "scale": "kindColor",
            "field": "kind"
          },
          "fillOpacity": {
            "signal": "max(0.3, 1 - (datum.depth * 0.25))"
          },
          "stroke": {
            "scale": "kindColor",
            "field": "kind"
          },
          "strokeOpacity": {
            "value": 0.7
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    }
  ]
}