@startuml
hide empty methods
class Client {
  name : String
  phone : String
}
class Table {
  number : Integer
  capacity : Integer
  zone : String
}
class Reservation {
  date : String
  time : String
  party_size : Integer
  status : String
}
Client "0..*" -- "0..*" Table
(Client, Table) .. Reservation
note bottom of Reservation
  extremos: booked_by, assigned_to
end note
@enduml
