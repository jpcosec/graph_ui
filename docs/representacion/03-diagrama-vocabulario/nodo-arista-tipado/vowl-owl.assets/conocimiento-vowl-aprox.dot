// APROXIMACIÓN de la notación VOWL hecha para este manual con Graphviz (no es la salida de WebVOWL):
// clases = círculos (color general), propiedades = rótulo rectangular sobre la línea, tipos de dato =
// rectángulos (uno por propiedad de dato: regla de división de VOWL), subclase = línea punteada con
// rótulo "Subclass of". Colores por función, según Lohmann et al. (2016), §3.1.2.
digraph vowl {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=10, arrowhead=normal];
  Surface    [shape=circle, style=filled, fillcolor="#aaccff", width=1.3, fixedsize=true];
  CliCommand [shape=circle, style=filled, fillcolor="#aaccff", width=1.3, fixedsize=true];
  Spec       [shape=circle, style=filled, fillcolor="#aaccff", width=1.3, fixedsize=true];
  implements [shape=box, style=filled, fillcolor="#aaccff", label="implements", height=0.3];
  sub        [shape=box, style="filled,dashed", fillcolor="#ffffff", label="Subclass of", height=0.3];
  p_title    [shape=box, style=filled, fillcolor="#99cc66", label="title", height=0.3];
  p_surface  [shape=box, style=filled, fillcolor="#99cc66", label="surface", height=0.3];
  p_cmd      [shape=box, style=filled, fillcolor="#99cc66", label="command_path", height=0.3];
  d1 [shape=box, style=filled, fillcolor="#ffcc33", label="string"];
  d2 [shape=box, style=filled, fillcolor="#ffcc33", label="string"];
  d3 [shape=box, style=filled, fillcolor="#ffcc33", label="string"];
  Surface -> implements [arrowhead=none]; implements -> Spec;
  CliCommand -> sub [arrowhead=none, style=dashed]; sub -> Surface [style=dashed, arrowhead=empty];
  Spec -> p_title [arrowhead=none]; p_title -> d1;
  Surface -> p_surface [arrowhead=none]; p_surface -> d2;
  CliCommand -> p_cmd [arrowhead=none]; p_cmd -> d3;
}
